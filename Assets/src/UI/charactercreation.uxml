<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/src/UI/uss/mainmenue_style.uss?fileID=7433441132597879392&amp;guid=7cdca454dedc5224bacce2cb7bc195ab&amp;type=3#mainmenue_style" />
    <ui:VisualElement name="Panel" style="flex-grow: 1; background-color: rgb(0, 0, 0); -unity-background-scale-mode: scale-to-fit; flex-direction: row;">
        <ui:VisualElement name="leftbox" style="flex-grow: 0; flex-basis: 15%;" />
        <ui:VisualElement name="midbox" style="flex-grow: 0; flex-basis: 70%;">
            <ui:VisualElement name="Header" style="flex-grow: 0; flex-basis: 10%;" />
            <ui:VisualElement name="MainFrame" style="flex-grow: 1; flex-basis: 80%; align-items: center;">
                <ui:Label text="Character Creation" name="Titel" style="color: rgb(0, 255, 223); -unity-text-align: middle-center; font-size: 91px; flex-basis: 20%;" />
                <ui:VisualElement name="NameContainer" style="flex-grow: 0; flex-basis: 20%;">
                    <ui:TextField label="Your name" placeholder-text="..." name="InputName" mask-character="*" is-delayed="false" max-length="32" class="txtInput" style="color: rgb(0, 130, 212); font-size: 39px; width: 700px; background-size: 90% 90%; -unity-background-scale-mode: scale-to-fit; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px;" />
                </ui:VisualElement>
                <ui:VisualElement name="ColorContainer" style="flex-grow: 0; flex-basis: 20%;" />
                <ui:VisualElement name="btnHolder" style="flex-grow: 0; flex-basis: 30%; flex-direction: row; align-items: center; justify-content: center;">
                    <ui:Button text="Back&#10;" name="Back" enabled="true" class="menueBtn" style="height: 30%; font-size: 20%;" />
                    <ui:Button text="Start New Game" name="StartGame" class="menueBtn" style="height: 30%; font-size: 20%; width: 80%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="flex-grow: 0; flex-basis: 10%;" />
        </ui:VisualElement>
        <ui:VisualElement name="rightbox" style="flex-grow: 0; flex-basis: 15%;" />
    </ui:VisualElement>
</ui:UXML>
