    <ui:VisualElement name="Panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.78); -unity-background-scale-mode: scale-to-fit; flex-direction: column; width: 25%; height: 100%; position: absolute; left: auto; right: auto;">
        <ui:VisualElement name="topbox" style="flex-grow: 0; flex-basis: 15%;" />
