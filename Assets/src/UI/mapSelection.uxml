<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/src/UI/uss/mainmenue_style.uss?fileID=7433441132597879392&amp;guid=7cdca454dedc5224bacce2cb7bc195ab&amp;type=3#mainmenue_style" />
    <ui:VisualElement name="Panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; flex-direction: row;">
        <ui:VisualElement name="leftbox" style="flex-grow: 0; flex-basis: 15%;" />
        <ui:VisualElement name="midbox" style="flex-grow: 0; flex-basis: 70%;">
            <ui:VisualElement name="Header" style="flex-grow: 0; flex-basis: 10%;" />
            <ui:VisualElement name="MainFrame" style="flex-grow: 1; flex-basis: 80%; background-color: rgba(19, 19, 19, 0.86); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; flex-direction: row;">
                <ui:ScrollView name="MapList" style="flex-grow: 1;" />
                <ui:VisualElement name="Detailframe" style="flex-grow: 0; flex-basis: 60%; flex-direction: column; width: 535px;">
                    <ui:VisualElement name="info" style="flex-grow: 1;">
                        <ui:Label text="Choose a Map.." name="Details" style="align-items: center; align-self: center; color: rgb(255, 255, 255); font-size: 39px;" />
                    </ui:VisualElement>
                    <ui:Button text="Start selected Map" name="StartMap" class="menueBtn" style="flex-basis: 10%; align-items: center; align-self: center; width: auto; height: 10%; font-size: 34px; padding-top: 30px; padding-right: 30px; padding-bottom: 30px; padding-left: 30px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="flex-grow: 0; flex-basis: 10%;" />
        </ui:VisualElement>
        <ui:VisualElement name="rightbox" style="flex-grow: 0; flex-basis: 15%;" />
    </ui:VisualElement>
</ui:UXML>
