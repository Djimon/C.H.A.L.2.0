<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/src/UI/uss/mainmenue_style.uss?fileID=7433441132597879392&amp;guid=7cdca454dedc5224bacce2cb7bc195ab&amp;type=3#mainmenue_style" />
    <ui:VisualElement name="Panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; flex-direction: row;">
        <ui:VisualElement name="leftbox" style="flex-grow: 0; flex-basis: 15%;" />
        <ui:VisualElement name="midbox" style="flex-grow: 0; flex-basis: 70%;">
            <ui:VisualElement name="Header" style="flex-grow: 0; flex-basis: 10%;" />
            <ui:VisualElement name="MainFrame" style="flex-grow: 1; flex-basis: 50%; background-color: rgba(0, 0, 0, 0.47); flex-direction: row;">
                <ui:ScrollView name="HeroContainer" style="flex-grow: 1;" />
                <ui:VisualElement name="HeroDetails" style="flex-grow: 0; flex-basis: 50%;">
                    <ui:VisualElement name="DetailsText" style="flex-grow: 1;">
                        <ui:Label text="Name" name="HeroName" style="color: rgb(255, 255, 255); font-size: 37px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="DetailFooter" style="flex-grow: 0; flex-basis: 20%; align-items: center; justify-content: space-around; align-self: stretch; align-content: stretch;">
                        <ui:Button text="Choose" name="ChooseHero" parse-escape-sequences="true" class="menueBtn" style="width: auto; height: 50%; margin-left: 50px; margin-right: 50px; padding-right: 20px; padding-left: 20px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="flex-grow: 0; flex-basis: 30%; background-color: rgba(0, 0, 0, 0.47); flex-direction: column; justify-content: space-around;">
                <ui:VisualElement name="slots" style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-self: auto; align-content: stretch; align-items: center;">
                    <ui:VisualElement name="Slot1" class="heroSlot" style="flex-grow: 1; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgba(0, 0, 0, 0.78); border-right-color: rgba(0, 0, 0, 0.78); border-top-color: rgba(0, 0, 0, 0.78); border-bottom-color: rgba(0, 0, 0, 0.78); align-items: center; justify-content: center; align-self: stretch; align-content: center;">
                        <ui:VisualElement name="IconSlot1" style="flex-basis: 80%; justify-content: space-between; align-self: stretch; align-content: stretch;" />
                        <ui:Button text="Select " selectable="true" name="BtnSlot1" class="slotBtn" style="flex-grow: 1; align-content: stretch; align-self: stretch; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Slot2" class="heroSlot" style="flex-grow: 1; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgba(0, 0, 0, 0.78); border-right-color: rgba(0, 0, 0, 0.78); border-top-color: rgba(0, 0, 0, 0.78); border-bottom-color: rgba(0, 0, 0, 0.78); align-items: center; justify-content: center; align-self: stretch; align-content: center;">
                        <ui:VisualElement name="IconSlot2" style="flex-basis: 80%; justify-content: space-between; align-self: stretch; align-content: stretch;" />
                        <ui:Button text="Select " selectable="true" name="BtnSlot2" class="slotBtn" style="flex-grow: 1; align-content: stretch; align-self: stretch; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Slot3" class="heroSlot" style="flex-grow: 1; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgba(0, 0, 0, 0.78); border-right-color: rgba(0, 0, 0, 0.78); border-top-color: rgba(0, 0, 0, 0.78); border-bottom-color: rgba(0, 0, 0, 0.78); align-items: center; justify-content: center; align-self: stretch; align-content: center;">
                        <ui:VisualElement name="IconSlot3" style="flex-basis: 80%; justify-content: space-between; align-self: stretch; align-content: stretch;" />
                        <ui:Button text="Select " selectable="true" name="BtnSlot3" class="slotBtn" style="flex-grow: 1; align-content: stretch; align-self: stretch; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Slot4" class="heroSlot" style="flex-grow: 1; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgba(0, 0, 0, 0.78); border-right-color: rgba(0, 0, 0, 0.78); border-top-color: rgba(0, 0, 0, 0.78); border-bottom-color: rgba(0, 0, 0, 0.78); align-items: center; justify-content: center; align-self: stretch; align-content: center;">
                        <ui:VisualElement name="IconSlot4" style="flex-basis: 80%; justify-content: space-between; align-self: stretch; align-content: stretch;" />
                        <ui:Button text="Select " selectable="true" name="BtnSlot4" class="slotBtn" style="flex-grow: 1; align-content: stretch; align-self: stretch; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Buttons" style="flex-grow: 0; flex-basis: 40%; flex-direction: row; align-items: center; justify-content: center;">
                    <ui:Button text="Back to Hideout&#10;" name="Hideout" class="menueBtn" style="width: auto; height: 60%; margin-right: 20px; padding-top: 13px; padding-right: 20px; padding-bottom: 13px; padding-left: 20px;" />
                    <ui:Button text="Start Wave" name="StartWave" class="menueBtn" style="width: auto; height: 60%; margin-right: 20px; padding-top: 13px; padding-right: 20px; padding-bottom: 13px; padding-left: 20px; margin-top: 20px; margin-bottom: 20px; margin-left: 20px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rightbox" style="flex-grow: 0; flex-basis: 15%;" />
    </ui:VisualElement>
</ui:UXML>
