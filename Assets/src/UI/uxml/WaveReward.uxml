<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/src/UI/uss/mainmenue_style.uss?fileID=7433441132597879392&amp;guid=7cdca454dedc5224bacce2cb7bc195ab&amp;type=3#mainmenue_style" />
    <ui:VisualElement name="Panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; flex-direction: row;">
        <ui:VisualElement name="leftbox" style="flex-grow: 0; flex-basis: 15%;" />
        <ui:VisualElement name="midbox" style="flex-grow: 0; flex-basis: 70%;">
            <ui:VisualElement name="Header" style="flex-grow: 0; flex-basis: 10%;" />
            <ui:VisualElement name="MainFrame" style="flex-grow: 1; flex-basis: 80%; background-color: rgba(0, 0, 0, 0.86);">
                <ui:VisualElement name="top" style="flex-grow: 0; flex-basis: 15%;" />
                <ui:VisualElement name="title" style="flex-grow: 1; flex-basis: auto; justify-content: space-around;">
                    <ui:Label text="Wave Completed" double-click-selects-word="false" style="color: rgb(255, 255, 255); font-size: 83px; -unity-text-align: middle-center; -unity-font-style: bold;" />
                    <ui:Label text="Label" name="WaveStatus" style="justify-content: flex-end; align-items: center; color: rgb(0, 0, 0); font-size: 36px; -unity-text-align: lower-center; align-content: auto;" />
                </ui:VisualElement>
                <ui:VisualElement name="AutoStartRow" style="flex-grow: 0; flex-basis: 12%; flex-shrink: 0; align-items: center; flex-direction: column; justify-content: center; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
                    <ui:Toggle label="Start all Waves automatically" name="AutoStartToggle" enabled="true" toggle-on-label-click="true" value="false" style="align-content: auto; color: rgb(255, 255, 255); font-size: 24px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                    <ui:Label text="0" name="AutoStartCountdown" enabled="true" style="font-size: 24px; color: rgb(255, 255, 255);" />
                </ui:VisualElement>
                <ui:VisualElement name="SelectionPanel" style="flex-grow: 0; flex-basis: 30%; flex-direction: row; align-self: auto; justify-content: center; align-content: auto; align-items: center;">
                    <ui:Button text="Retry" name="Retry" class="menueBtn" style="font-size: 30px; width: 20%; height: 20%;" />
                    <ui:Button text="Next Wave" parse-escape-sequences="false" emoji-fallback-support="false" name="Next" class="menueBtn" style="font-size: 30px; width: 20%; height: 20%;" />
                    <ui:Button text="To Hideout" name="Hideout" class="menueBtn" style="font-size: 30px; width: 20%; height: 20%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Footer" style="flex-grow: 0; flex-basis: 10%;" />
        </ui:VisualElement>
        <ui:VisualElement name="rightbox" style="flex-grow: 0; flex-basis: 15%;" />
    </ui:VisualElement>
</ui:UXML>
