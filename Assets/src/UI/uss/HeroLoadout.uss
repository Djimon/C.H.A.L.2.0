/* =========================================================
   HeroLoadoutView.uss
   ========================================================= */

/* ---------- ROOT ---------- */
.hero-loadout-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(30, 8, 52);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
}

/* ---------- PANELS (generic) ---------- */
.panel {
    background-color: rgba(140, 140, 155, 0.55);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(0, 0, 0, 0.25);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.25);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
}

/* ---------- HEADER (Hero selection) ---------- */
.hero-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
}

.nav-btn {
    width: 40px;
    height: 40px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    background-color: rgba(80, 170, 190, 0.55);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(0, 0, 0, 0.30);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(0, 0, 0, 0.30);

    color: rgb(245, 245, 245);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nav-btn-left { margin-right: 10px; }
.nav-btn-right { margin-left: 10px; }

.hero-carousel {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 360px;
}

.hero-avatar-strip {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: 54px;
}

.hero-name {
    margin-top: 6px;
    color: rgb(205, 245, 255);
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-outline-width: 1px;
}

/* ---------- MAIN LAYOUT ---------- */
.main {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 14px;
}

/* left (hero display) ~ 1/3 */
.hero-display-panel {
    flex-grow: 0;
    width: 33%;
    margin-right: 14px;
}

.hero-portrait-frame {
    flex-grow: 1;
    background-color: rgba(60, 60, 75, 0.55);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(0, 0, 0, 0.25);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.25);

    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.hero-portrait {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 20, 30, 0.15);
}

.hero-mini-stats {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
}

.mini-stat {
    color: rgba(255,255,255,0.85);
    font-size: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0,0,0,0.55);
}

/* right (loadout) ~ 2/3 */
.loadout-panel {
    flex-grow: 1;
}

/* ---------- TAB BAR ---------- */
.tab-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 12px;
}

.tab {
    height: 38px;
    min-width: 110px;

    margin-right: 10px;
    padding-left: 18px;
    padding-right: 18px;

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    background-color: rgba(150, 150, 165, 0.55);

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(0, 0, 0, 0.30);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.30);

    color: rgba(255,255,255,0.90);
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.tab-selected {
    background-color: rgba(80, 200, 210, 0.65);
    border-left-color: rgba(255, 255, 255, 0.20);
    border-top-color: rgba(255, 255, 255, 0.20);
    border-right-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: rgba(0, 0, 0, 0.35);
    -unity-text-outline-width: 1px;
}

/* ---------- TAB CONTENT ---------- */
.tab-content {
    flex-grow: 1;
}

/* ---------- SLOTS (shared visuals) ---------- */
.slot-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 10px;
}

.slot-label {
    width: 160px;
    color: rgba(255,255,255,0.85);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
}

.slot-item-label {
    flex-grow: 1;
    color: rgba(255,255,255,0.80);
    font-size: 16px;
    -unity-text-outline-width: 1px;
}

.slot-drop {
    width: 44px;
    height: 44px;
    margin-right: 12px;

    background-color: rgba(95, 95, 110, 0.70);

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(0, 0, 0, 0.30);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.30);
}

.slot-drop-skill {
    width: 48px;
    height: 48px;
}

/* amulet row is a bit special in your wireframe */
.slot-row-amulet {
    margin-top: 14px;
}

.slot-label-amulet {
    width: 160px;
}

.slot-drop-amulet {
    margin-left: 6px;
}

/* ---------- SKILL SOCKETS ---------- */
.skill-sockets {
    flex-direction: column;
    padding-top: 6px;
}

.skill-socket {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.socket-item-label {
    color: rgba(255,255,255,0.90);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
}

.locked {
    opacity: 0.55;
}

.lock-overlay {
    width: 18px;
    height: 18px;
    margin-left: 10px;
    background-color: rgba(0,0,0,0.25);

    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* Hint text */
.hint-text {
    margin-top: 10px;
    color: rgba(255,255,255,0.70);
    font-size: 12px;
    -unity-text-outline-width: 1px;
}

/* ---------- INFO TAB ---------- */
.section-title {
    color: rgba(255,255,255,0.90);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;

}

.paragraph {
    color: rgba(255,255,255,0.82);
    font-size: 14px;
    margin-bottom: 12px;
    white-space: normal;
}

.passive-name {
    color: rgb(205, 245, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0,0,0,0.70);
}

.divider {
    height: 2px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: rgba(255,255,255,0.10);
}

.hero-stats-scroll {
    flex-grow: 1;
    max-height: 220px;
}

.list-container {
    flex-direction: column;
}

/* ---------- BOTTOM PANEL ---------- */
.bottom-panel {
    flex-grow: 0;
    min-height: 240px;
}

.bottom-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.panel-title {
    color: rgba(255,255,255,0.90);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0,0,0,0.70);
}

.bottom-actions {
    flex-direction: row;
    align-items: center;
}

.btn {
    height: 30px;
    min-width: 70px;

    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    background-color: rgba(110, 110, 125, 0.55);

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(0, 0, 0, 0.30);
    border-top-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(0, 0, 0, 0.30);

    color: rgba(255,255,255,0.85);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.btn-small { min-width: 60px; }

.inventory-scroll {
    flex-grow: 1;
    background-color: rgba(60, 60, 75, 0.35);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(0, 0, 0, 0.25);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.25);

    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}
