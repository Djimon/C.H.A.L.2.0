.root {
    padding: 10px;
    flex-direction: column;
    height: 100%;
}

.title {
    font-style: bold;
    font-size: 14px;
    margin-bottom: 8px;
    opacity: 0.9;
}

.scroll {
    flex-grow: 1;
}

.foldout {
    margin-bottom: 10px;
}

.group {
    padding: 8px;
    margin-top: 6px;
    border-left-width: 2px;
    border-left-color: rgba(255,255,255,0.10);
    background-color: rgba(255,255,255,0.03);
}

.subcard {
    margin-top: 8px;
    padding: 8px;
    background-color: rgba(255,255,255,0.02);
    border-top-width: 1px;
    border-top-color: rgba(255,255,255,0.08);
}

.subtitle {
    unity-font-style: bold;
    margin-bottom: 6px;
    opacity: 0.85;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    flex-wrap: wrap;
}

.row-2 {
    justify-content: space-between;
}

.row-3 .btn {
    flex-grow: 1;
}

.row-4 .btn {
    flex-grow: 1;
}

.col {
    flex-direction: column;
    flex-grow: 1;
    min-width: 280px;
}

.label {
    min-width: 90px;
    opacity: 0.85;
}

.hint {
    opacity: 0.7;
}

.dd {
    min-width: 260px;
}

.dd.small {
    min-width: 90px;
}

.int {
    min-width: 70px;
}

.btn {
    min-width: 160px;
}

.btn.primary {
    font-style: bold;
}

.btn.danger {
    font-style: bold;
}

.listbox {
    flex-direction: column;
    padding: 6px;
    background-color: rgba(0,0,0,0.15);
    border-left-width: 2px;
    border-left-color: rgba(255,255,255,0.10);
}
